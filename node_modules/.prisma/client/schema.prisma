generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cuidador {
  id            String     @id @default(cuid())
  nome          String
  email         String     @unique
  password_hash String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  pacientes     Paciente[]
}

model Paciente {
  id                  String      @id @default(cuid())
  nome                String
  dataDeNascimento    String
  telefone            String
  sexo                String
  email               String      @unique
  estadoCivil         String
  nomeDaMae           String
  nomeDoPai           String
  nacionalidade       String
  contatoDeEmergencia String
  endereco            String
  cep                 String
  tipoSanguineo       String
  alergias            String
  doencaCronica       String
  medicamentosEmUso   String
  createdAt           DateTime    @default(now())
  cuidadorId          String
  cuidador            Cuidador    @relation(fields: [cuidadorId], references: [id])
  relatorios          Relatorio[]
}

model Relatorio {
  id                String   @id @default(cuid())
  dataVisita        String
  horaVisita        String
  tipoVisita        String
  descricaoVisita   String
  observacoesVisita String?
  medicamentos      String
  localizacaoDor    String?
  horarioMeds       String?
  pressaoArterial   String?
  temperatura       String?
  peso              String?
  createdAt         DateTime @default(now())
  pacienteId        String
  paciente          Paciente @relation(fields: [pacienteId], references: [id])
}
